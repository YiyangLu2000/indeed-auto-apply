# Copy to .env and adjust. All optional — sensible defaults are used.

# Fernet key for session encryption at rest. Resolution order:
#   1. INDEED_SESSION_KEY       — raw urlsafe-base64 Fernet key (highest priority)
#   2. INDEED_SESSION_KEY_FILE  — path to a file holding that key
#   3. .secrets/session.key     — default file, created by `keygen`
# INDEED_SESSION_KEY=
# INDEED_SESSION_KEY_FILE=.secrets/session.key

# SQLite database path (git-ignored by default).
# INDEED_DB_PATH=data/applications.db

# Encrypted session blob path.
# INDEED_SESSION_ENC=.secrets/session.enc

# Path to the candidate profile.
# INDEED_PROFILE_PATH=profile.json

# Browser to drive. Unset = Playwright's bundled Chromium. Set to "chrome" (or
# "msedge") to drive your real installed browser instead — often clears a
# Cloudflare check that the bundled build loops on. Per-command: --browser chrome
# INDEED_BROWSER_CHANNEL=chrome
